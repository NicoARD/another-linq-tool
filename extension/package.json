{
  "name": "another-linq-tool",
  "displayName": "Another LINQ Tool",
  "description": "Run C# scripts as interactive LINQ query windows.",
  "icon": "./icon.png",
  "version": "1.0.0",
  "publisher": "another-linq-tool",
  "license": "CC-BY-NC-4.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "linq",
    "csharp",
    "dotnet",
    "query",
    "script"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:linq-csx"
  ],
  "contributes": {
    "languages": [
      {
        "id": "linq-csx",
        "aliases": [
          "LINQ C# Script"
        ],
        "extensions": [
          ".linq",
          ".csx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "keybindings": [
      {
        "command": "linqRunner.runCurrentFile",
        "key": "ctrl+enter",
        "when": "editorTextFocus && (resourceExtname == .linq || resourceExtname == .csx)"
      }
    ],
    "commands": [
      {
        "command": "linqRunner.runCurrentFile",
        "title": "Another LINQ Tool: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "linqRunner.restartRunner",
        "title": "Another LINQ Tool: Restart Runner"
      },
      {
        "command": "linqRunner.selectProfile",
        "title": "Another LINQ Tool: Select Profile"
      },
      {
        "command": "linqRunner.configure",
        "title": "Another LINQ Tool: Configure Profiles",
        "icon": "$(gear)"
      },
      {
        "command": "linqRunner.openGlobalProfiles",
        "title": "Another LINQ Tool: Configure Global Profiles"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "linqRunner.runCurrentFile",
          "when": "resourceExtname == .linq || resourceExtname == .csx",
          "group": "navigation"
        },
        {
          "command": "linqRunner.configure",
          "when": "resourceExtname == .linq || resourceExtname == .csx",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Another LINQ Tool",
      "properties": {
        "linqRunner.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "scope": "machine",
          "description": "Path to the dotnet executable used to launch the runner."
        },
        "linqRunner.runnerPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to LinqRunner.dll. When empty, the runner bundled with this extension is used."
        },
        "linqRunner.rowLimit": {
          "type": "number",
          "default": 1000,
          "scope": "machine",
          "description": "Maximum number of rows materialized from a sequence result."
        },
        "linqRunner.profiles": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "description": "Named Another LINQ Tool execution profiles shared by all VS Code windows. Connection strings are stored separately in Secret Storage.",
          "additionalProperties": {
            "type": "object"
          }
        },
        "linqRunner.defaultProfile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Name of the default Another LINQ Tool execution profile shared by all VS Code windows."
        }
      }
    }
  },
  "scripts": {
    "build:runner": "node ./scripts/build-runner.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run build:runner && npm run compile",
    "prepackage": "node ./scripts/check-release-node.js",
    "package": "vsce package --no-dependencies",
    "release:check": "npm run build:runner && npm run compile && npm run package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.2.0"
  }
}

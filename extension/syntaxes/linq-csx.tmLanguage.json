{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LINQ C# Script",
  "scopeName": "source.linq-csx",
  "patterns": [
    {
      "begin": "^(\\s*)(<)(Query)(?=\\s|>)",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.tag.begin.xml"
        },
        "3": {
          "name": "entity.name.tag.localname.xml"
        }
      },
      "end": "^(\\s*)(</)(Query)(\\s*>)",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.tag.begin.xml"
        },
        "3": {
          "name": "entity.name.tag.localname.xml"
        },
        "4": {
          "name": "punctuation.definition.tag.end.xml"
        }
      },
      "name": "meta.embedded.block.xml.linq-csx",
      "contentName": "text.xml",
      "patterns": [
        {
          "include": "text.xml"
        }
      ]
    },
    {
      "match": "^(\\s*)(?:(//)[ \\t]*)?(@(profile|kind|query|namespace))([ \\t]+)([^\\r\\n]+)$",
      "captures": {
        "2": {
          "name": "punctuation.definition.comment.linq-csx"
        },
        "3": {
          "name": "keyword.control.directive.linq-csx"
        },
        "6": {
          "name": "string.unquoted.directive-value.linq-csx"
        }
      }
    },
    {
      "include": "source.cs"
    }
  ]
}
